      "props": [{ "name": "audience", "value": "\"admin\"" }],
      "when": [],
      "action": null
    },
    {
      "id": "page-stack",
      "component": "Stack",
      "parent": "screen",
      "slot": "body",
      "props": [
        { "name": "direction", "value": "\"column\"" },
        { "name": "gap", "value": "\"lg\"" }
      ],
      "when": [],
      "action": null
    },
    {
      "id": "page-header",
      "component": "PageHeader",
      "parent": "page-stack",
      "slot": "body",
      "props": [],
      "when": [],
      "action": null
    },
    {
      "id": "page-title",
      "component": "Heading",
      "parent": "page-header",
      "slot": "title",
      "props": [
        { "name": "text", "value": "\"Pay invoices\"" },
        { "name": "level", "value": "1" }
      ],
      "when": [],
      "action": null
    },
    {
      "id": "invoice-table",
      "component": "DataTable",
      "parent": "page-stack",
      "slot": "body",
      "props": [
        { "name": "rows", "value": "{\"bind\":\"payQueue\"}" },
        {
          "name": "columns",
          "value": "[\"Invoice\",\"Contractor\",\"Amount\",\"Due\",\"Status\"]"
        },
        {
          "name": "selectionText",
          "value": "{\"none\":\"No invoices selected\",\"one\":\"1 invoice selected\",\"other\":\"{count} invoices selected\"}"
        }
      ],
