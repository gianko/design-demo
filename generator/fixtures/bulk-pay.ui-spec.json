          "name": "text",
          "value": "\"The payment didn't go through, so nothing was scheduled. Check your funding account, then try again.\""
        },
        { "name": "tone", "value": "\"failure\"" },
        { "name": "closeLabel", "value": "\"Close payment result\"" }
      ],
      "when": ["payment-failed"],
      "action": null
