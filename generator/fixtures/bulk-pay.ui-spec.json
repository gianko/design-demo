      "slot": "cell",
      "props": [{ "name": "text", "value": "{\"bind\":\"row.number\"}" }],
      "when": [],
      "action": null
    },
    {
      "id": "cell-contractor",
      "component": "Text",
      "parent": "invoice-table",
      "slot": "cell",
      "props": [{ "name": "text", "value": "{\"bind\":\"row.contractor\"}" }],
      "when": [],
      "action": null
    },
    {
      "id": "cell-amount",
      "component": "Amount",
      "parent": "invoice-table",
      "slot": "cell",
      "props": [
        { "name": "value", "value": "{\"bind\":\"row.amount\"}" },
        { "name": "currency", "value": "{\"bind\":\"row.currency\"}" },
        { "name": "display", "value": "\"table\"" }
      ],
      "when": [],
      "action": null
    },
    {
      "id": "cell-due",
      "component": "Text",
      "parent": "invoice-table",
      "slot": "cell",
      "props": [{ "name": "text", "value": "{\"bind\":\"row.dueLabel\"}" }],
      "when": [],
      "action": null
    },
    {
      "id": "cell-status",
      "component": "StatusTag",
      "parent": "invoice-table",
      "slot": "cell",
      "props": [{ "name": "status", "value": "{\"bind\":\"row.status\"}" }],
      "when": [],
      "action": null
    },
    {
      "id": "pay-button",
      "component": "Button",
      "parent": "invoice-table",
      "slot": "actions",
      "props": [
        { "name": "text", "value": "\"Pay selected\"" },
        { "name": "intent", "value": "\"primary\"" }
      ],
      "when": [],
      "action": "pay-selected"
    },
    {
      "id": "empty-queue",
      "component": "EmptyState",
      "parent": "page-stack",
      "slot": "body",
      "props": [
        { "name": "title", "value": "\"No invoices to pay\"" },
        {
          "name": "text",
          "value": "\"New invoices show up here when contractors send them.\""
        }
      ],
      "when": ["empty"],
      "action": null
    },
    {
      "id": "failure-toast",
      "component": "Toast",
      "parent": "page-stack",
      "slot": "body",
      "props": [
