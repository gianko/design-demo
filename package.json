{
  "name": "design-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc",
    "tokens": "node tokens/build.ts",
    "figma:sync-tokens": "node figma/sync-tokens.ts",
    "gate": "node gates/run.ts",
    "build-component": "node build-loop/build-component.ts",
    "build-loop": "node build-loop/build-loop.ts",
    "generate": "tsx generator/bin/generate.ts",
    "keep": "tsx generator/bin/keep.ts",
    "test": "vitest run",
    "test:gate": "vitest run --config gates/e2e.config.ts",
    "lint": "eslint .",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\""
  },
  "dependencies": {
    "@fontsource/instrument-sans": "5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.2.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/react-vite": "^10.6.3",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "culori": "^4.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "^3.9.10",
    "storybook": "^10.6.3",
    "tailwind-csstree": "^0.4.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
