/* The closed theme: Tailwind's defaults are gone, and only these classes compile
   (ADR 0002). Each maps to a mode-aware --ds-* variable. */
@theme inline {
  --*: initial;
  --background-color-page: var(--ds-color-bg-page);
  --background-color-surface: var(--ds-color-bg-surface);
  --background-color-surface-raised: var(--ds-color-bg-surface-raised);
  --background-color-surface-hover: var(--ds-color-bg-surface-hover);
  --background-color-surface-pressed: var(--ds-color-bg-surface-pressed);
  --background-color-selected: var(--ds-color-bg-selected);
  --background-color-accent: var(--ds-color-bg-accent);
  --background-color-accent-hover: var(--ds-color-bg-accent-hover);
  --background-color-accent-pressed: var(--ds-color-bg-accent-pressed);
  --background-color-progress: var(--ds-color-bg-progress);
  --background-color-disabled: var(--ds-color-bg-disabled);
  --background-color-scrim: var(--ds-color-bg-scrim);
  --background-color-awaiting: var(--ds-color-bg-awaiting);
  --background-color-overdue: var(--ds-color-bg-overdue);
  --background-color-paid: var(--ds-color-bg-paid);
  --background-color-scheduled: var(--ds-color-bg-scheduled);
  --background-color-failed: var(--ds-color-bg-failed);
  --text-color-ink: var(--ds-color-text-ink);
  --text-color-ink-muted: var(--ds-color-text-ink-muted);
  --text-color-accent: var(--ds-color-text-accent);
  --text-color-on-accent: var(--ds-color-text-on-accent);
  --text-color-disabled: var(--ds-color-text-disabled);
  --text-color-awaiting: var(--ds-color-text-awaiting);
  --text-color-overdue: var(--ds-color-text-overdue);
  --text-color-paid: var(--ds-color-text-paid);
  --text-color-scheduled: var(--ds-color-text-scheduled);
  --text-color-failed: var(--ds-color-text-failed);
  --border-color-line: var(--ds-color-border-line);
  --border-color-control: var(--ds-color-border-control);
  --border-color-disabled: var(--ds-color-border-disabled);
  --ring-color-focus: var(--ds-color-ring-focus);
  --shadow-raised: var(--ds-shadow-raised);
  --shadow-overlay: var(--ds-shadow-overlay);
  --padding-page: var(--ds-density-padding-page);
  --padding-control: var(--ds-density-padding-control);
  --padding-surface: var(--ds-density-padding-surface);
  --height-row: var(--ds-density-height-row);
  --height-control: var(--ds-density-height-control);
  --min-height-target: var(--ds-density-min-height-target);
  --max-width-measure: var(--ds-density-max-width-measure);
  --size-icon: var(--ds-density-size-icon);
  --radius-surface: var(--ds-density-radius-surface);
  --spacing-0: var(--ds-space-0);
  --spacing-3xs: var(--ds-space-3xs);
  --spacing-2xs: var(--ds-space-2xs);
  --spacing-xs: var(--ds-space-xs);
  --spacing-sm: var(--ds-space-sm);
  --spacing-md: var(--ds-space-md);
  --spacing-lg: var(--ds-space-lg);
  --spacing-xl: var(--ds-space-xl);
  --spacing-2xl: var(--ds-space-2xl);
  --spacing-3xl: var(--ds-space-3xl);
  --spacing-4xl: var(--ds-space-4xl);
  --height-edge: var(--ds-size-height-edge);
  --width-sheet: var(--ds-size-width-sheet);
  --max-width-card: var(--ds-size-max-width-card);
  --radius-control: var(--ds-radius-control);
  --radius-tag: var(--ds-radius-tag);
  --radius-avatar: var(--ds-radius-avatar);
  --font-sans: var(--ds-type-family-sans);
  --default-font-family: var(--ds-type-family-sans);
  --ease-standard: var(--ds-motion-ease-standard);
  --ease-exit: var(--ds-motion-ease-exit);
  --ease-settle: var(--ds-motion-ease-settle);
  --ease-linear: var(--ds-motion-ease-linear);
  --animate-progress-fill: var(--ds-motion-animate-progress-fill);
  --animate-progress-sweep: var(--ds-motion-animate-progress-sweep);
  --z-index-raised: var(--ds-z-raised);
  --z-index-overlay: var(--ds-z-overlay);
  --z-index-toast: var(--ds-z-toast);
}

/* Bare-value families and text roles get named utilities. */
@utility text-body {
  font-size: var(--ds-density-text-body-font-size);
  line-height: var(--ds-density-text-body-line-height);
  letter-spacing: var(--ds-density-text-body-letter-spacing);
  font-weight: var(--tw-font-weight, var(--ds-density-text-body-font-weight));
}
@utility text-label {
  font-size: var(--ds-density-text-label-font-size);
  line-height: var(--ds-density-text-label-line-height);
  letter-spacing: var(--ds-density-text-label-letter-spacing);
  font-weight: var(--tw-font-weight, var(--ds-density-text-label-font-weight));
}
@utility text-caption {
  font-size: var(--ds-type-caption-font-size);
  line-height: var(--ds-type-caption-line-height);
  letter-spacing: var(--ds-type-caption-letter-spacing);
  font-weight: var(--tw-font-weight, var(--ds-type-caption-font-weight));
}
@utility text-heading {
  font-size: var(--ds-type-heading-font-size);
  line-height: var(--ds-type-heading-line-height);
  letter-spacing: var(--ds-type-heading-letter-spacing);
  font-weight: var(--tw-font-weight, var(--ds-type-heading-font-weight));
}
@utility text-title {
  font-size: var(--ds-type-title-font-size);
  line-height: var(--ds-type-title-line-height);
  letter-spacing: var(--ds-type-title-letter-spacing);
  font-weight: var(--tw-font-weight, var(--ds-type-title-font-weight));
}
@utility text-figure {
  font-size: var(--ds-type-figure-font-size);
  line-height: var(--ds-type-figure-line-height);
  letter-spacing: var(--ds-type-figure-letter-spacing);
  font-weight: var(--tw-font-weight, var(--ds-type-figure-font-weight));
}
@utility duration-fast {
  transition-duration: var(--ds-motion-duration-fast);
  animation-duration: var(--ds-motion-duration-fast);
}
@utility duration-base {
  transition-duration: var(--ds-motion-duration-base);
  animation-duration: var(--ds-motion-duration-base);
}
@utility duration-slow {
  transition-duration: var(--ds-motion-duration-slow);
  animation-duration: var(--ds-motion-duration-slow);
}
@utility duration-fast-exit {
  transition-duration: var(--ds-motion-duration-fast-exit);
  animation-duration: var(--ds-motion-duration-fast-exit);
}
@utility duration-base-exit {
  transition-duration: var(--ds-motion-duration-base-exit);
  animation-duration: var(--ds-motion-duration-base-exit);
}
@utility duration-slow-exit {
  transition-duration: var(--ds-motion-duration-slow-exit);
  animation-duration: var(--ds-motion-duration-slow-exit);
}
@utility duration-loop {
  transition-duration: var(--ds-motion-duration-loop);
  animation-duration: var(--ds-motion-duration-loop);
}
@utility delay-stagger {
  transition-delay: var(--ds-motion-delay-stagger);
  animation-delay: var(--ds-motion-delay-stagger);
}
@utility focus-ring {
  outline: var(--ds-size-height-edge) solid var(--ds-color-ring-focus);
  outline-offset: var(--ds-size-height-edge);
}

/* tokens/keyframes.css, verbatim. */

/* Hand-written keyframes (ADR 0005). DTCG has no keyframe type and Figma can't
   carry one, so tokens/build.ts appends this file to tokens.css verbatim. Build
   sessions never edit it. */

/* The progress edge ends full, */
@keyframes progress-fill {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

/* and the sweep starts full and wraps around: the edge slides out to the
   right and back in from the left, so nothing jumps. Every frame sets the
   sweep's width and \`translate\`, replacing its rest values, so a sweep that is
   narrower at rest (Button's has no width) is the full edge while it runs. Not
   \`translate: none\` beside a \`transform\`: the production minifier drops it. */
@keyframes progress-sweep {
  0% {
    width: 100%;
    translate: 0;
  }
  50% {
    width: 100%;
    translate: 100%;
  }
  50.01% {
    width: 100%;
    translate: -100%;
  }
  100% {
    width: 100%;
    translate: 0;
  }
}
"
`;

exports[`builds tokens.css, tokens.ts and the Figma payload from the committed sources 2`] = `
"// Generated by tokens/build.ts. Don't edit: change a source and run \`pnpm tokens\`.
// Token names only, one tuple and union per family, for the registry's z.enum() (ADR 0005).

export const backgroundColor = ["page", "surface", "surface-raised", "surface-hover", "surface-pressed", "selected", "accent", "accent-hover", "accent-pressed", "progress", "disabled", "scrim", "awaiting", "overdue", "paid", "scheduled", "failed"] as const;
export type BackgroundColor = (typeof backgroundColor)[number];

export const textColor = ["ink", "ink-muted", "accent", "on-accent", "disabled", "awaiting", "overdue", "paid", "scheduled", "failed"] as const;
export type TextColor = (typeof textColor)[number];

export const borderColor = ["line", "control", "disabled"] as const;
export type BorderColor = (typeof borderColor)[number];

export const ringColor = ["focus"] as const;
export type RingColor = (typeof ringColor)[number];

export const shadow = ["raised", "overlay"] as const;
export type Shadow = (typeof shadow)[number];

export const padding = ["page", "control", "surface"] as const;
export type Padding = (typeof padding)[number];

export const height = ["row", "control", "edge"] as const;
export type Height = (typeof height)[number];

export const minHeight = ["target"] as const;
export type MinHeight = (typeof minHeight)[number];

export const maxWidth = ["measure", "card"] as const;
export type MaxWidth = (typeof maxWidth)[number];

export const size = ["icon"] as const;
export type Size = (typeof size)[number];

export const radius = ["surface", "control", "tag", "avatar"] as const;
export type Radius = (typeof radius)[number];

export const text = ["body", "label", "caption", "heading", "title", "figure"] as const;
export type Text = (typeof text)[number];

export const spacing = ["0", "3xs", "2xs", "xs", "sm", "md", "lg", "xl", "2xl", "3xl", "4xl"] as const;
export type Spacing = (typeof spacing)[number];

export const width = ["sheet"] as const;
export type Width = (typeof width)[number];

export const font = ["sans"] as const;
export type Font = (typeof font)[number];

export const duration = ["fast", "base", "slow", "fast-exit", "base-exit", "slow-exit", "loop"] as const;
export type Duration = (typeof duration)[number];

export const delay = ["stagger"] as const;
export type Delay = (typeof delay)[number];

export const ease = ["standard", "exit", "settle", "linear"] as const;
export type Ease = (typeof ease)[number];

export const animate = ["progress-fill", "progress-sweep"] as const;
export type Animate = (typeof animate)[number];

export const zIndex = ["raised", "overlay", "toast"] as const;
export type ZIndex = (typeof zIndex)[number];
"
`;

