  --text-color-overdue: var(--ds-color-text-overdue);
  --text-color-paid: var(--ds-color-text-paid);
  --text-color-scheduled: var(--ds-color-text-scheduled);
  --text-color-failed: var(--ds-color-text-failed);
  --border-color-line: var(--ds-color-border-line);
  --border-color-control: var(--ds-color-border-control);
  --ring-color-focus: var(--ds-color-ring-focus);
  --shadow-raised: var(--ds-shadow-raised);
  --shadow-overlay: var(--ds-shadow-overlay);
  --padding-page: var(--ds-density-padding-page);
