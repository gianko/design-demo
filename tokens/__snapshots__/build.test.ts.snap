  --text-body--letter-spacing: var(--ds-density-text-body-letter-spacing);
  --text-body--font-weight: var(--ds-density-text-body-font-weight);
  --text-label: var(--ds-density-text-label-font-size);
  --text-label--line-height: var(--ds-density-text-label-line-height);
  --text-label--letter-spacing: var(--ds-density-text-label-letter-spacing);
  --text-label--font-weight: var(--ds-density-text-label-font-weight);
  --spacing-0: var(--ds-space-0);
  --spacing-3xs: var(--ds-space-3xs);
  --spacing-2xs: var(--ds-space-2xs);
  --spacing-xs: var(--ds-space-xs);
  --spacing-sm: var(--ds-space-sm);
  --spacing-md: var(--ds-space-md);
  --spacing-lg: var(--ds-space-lg);
  --spacing-xl: var(--ds-space-xl);
  --spacing-2xl: var(--ds-space-2xl);
  --spacing-3xl: var(--ds-space-3xl);
  --spacing-4xl: var(--ds-space-4xl);
  --height-edge: var(--ds-size-height-edge);
  --width-sheet: var(--ds-size-width-sheet);
  --radius-control: var(--ds-radius-control);
  --radius-tag: var(--ds-radius-tag);
  --radius-avatar: var(--ds-radius-avatar);
  --font-sans: var(--ds-type-family-sans);
  --default-font-family: var(--ds-type-family-sans);
  --text-caption: var(--ds-type-caption-font-size);
  --text-caption--line-height: var(--ds-type-caption-line-height);
