  --text-title--line-height: var(--ds-type-title-line-height);
  --text-title--letter-spacing: var(--ds-type-title-letter-spacing);
  --text-title--font-weight: var(--ds-type-title-font-weight);
  --text-figure: var(--ds-type-figure-font-size);
  --text-figure--line-height: var(--ds-type-figure-line-height);
  --text-figure--letter-spacing: var(--ds-type-figure-letter-spacing);
  --text-figure--font-weight: var(--ds-type-figure-font-weight);
  --ease-standard: var(--ds-motion-ease-standard);
  --ease-exit: var(--ds-motion-ease-exit);
  --ease-settle: var(--ds-motion-ease-settle);
  --ease-linear: var(--ds-motion-ease-linear);
  --animate-progress-fill: var(--ds-motion-animate-progress-fill);
  --animate-progress-sweep: var(--ds-motion-animate-progress-sweep);
  --z-index-raised: var(--ds-z-raised);
  --z-index-overlay: var(--ds-z-overlay);
  --z-index-toast: var(--ds-z-toast);
}

/* Bare-value families get named utilities. */
@utility duration-fast {
  transition-duration: var(--ds-motion-duration-fast);
  animation-duration: var(--ds-motion-duration-fast);
}
@utility duration-base {
  transition-duration: var(--ds-motion-duration-base);
  animation-duration: var(--ds-motion-duration-base);
}
@utility duration-slow {
  transition-duration: var(--ds-motion-duration-slow);
  animation-duration: var(--ds-motion-duration-slow);
}
@utility duration-fast-exit {
  transition-duration: var(--ds-motion-duration-fast-exit);
  animation-duration: var(--ds-motion-duration-fast-exit);
}
@utility duration-base-exit {
  transition-duration: var(--ds-motion-duration-base-exit);
  animation-duration: var(--ds-motion-duration-base-exit);
}
@utility duration-slow-exit {
  transition-duration: var(--ds-motion-duration-slow-exit);
  animation-duration: var(--ds-motion-duration-slow-exit);
}
@utility duration-loop {
  transition-duration: var(--ds-motion-duration-loop);
  animation-duration: var(--ds-motion-duration-loop);
}
@utility delay-stagger {
  transition-delay: var(--ds-motion-delay-stagger);
  animation-delay: var(--ds-motion-delay-stagger);
}
@utility focus-ring {
  outline: var(--ds-size-height-edge) solid var(--ds-color-ring-focus);
  outline-offset: var(--ds-size-height-edge);
}

/* tokens/keyframes.css, verbatim. */

/* Hand-written keyframes (ADR 0005). DTCG has no keyframe type and Figma can't
   carry one, so tokens/build.ts appends this file to tokens.css verbatim. Build
   sessions never edit it. */

/* The progress edge ends full, */
@keyframes progress-fill {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

/* and the sweep starts full and wraps around: the edge slides out to the
   right and back in from the left, so nothing jumps. */
@keyframes progress-sweep {
  0% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(100%);
  }
  50.01% {
    transform: translateX(-100%);
  }
  100% {
    transform: translateX(0);
  }
}
"
`;

exports[`builds tokens.css, tokens.ts and the Figma payload from the committed sources 2`] = `
"// Generated by tokens/build.ts. Don't edit: change a source and run \`pnpm tokens\`.
// Token names only, one tuple and union per family, for the registry's z.enum() (ADR 0005).

export const backgroundColor = ["page", "surface", "surface-raised", "surface-hover", "surface-pressed", "selected", "accent", "accent-hover", "accent-pressed", "on-accent", "disabled", "scrim", "awaiting", "overdue", "paid", "scheduled", "failed"] as const;
export type BackgroundColor = (typeof backgroundColor)[number];

export const textColor = ["ink", "ink-muted", "accent", "on-accent", "disabled", "awaiting", "overdue", "paid", "scheduled", "failed"] as const;
export type TextColor = (typeof textColor)[number];

export const borderColor = ["line", "control"] as const;
export type BorderColor = (typeof borderColor)[number];

export const ringColor = ["focus"] as const;
export type RingColor = (typeof ringColor)[number];

export const shadow = ["raised", "overlay"] as const;
export type Shadow = (typeof shadow)[number];

export const padding = ["page", "control"] as const;
export type Padding = (typeof padding)[number];

export const height = ["row", "control", "edge"] as const;
export type Height = (typeof height)[number];

export const minHeight = ["target"] as const;
export type MinHeight = (typeof minHeight)[number];

export const size = ["icon"] as const;
export type Size = (typeof size)[number];

export const radius = ["surface", "control", "tag", "avatar"] as const;
export type Radius = (typeof radius)[number];

export const text = ["body", "label", "caption", "heading", "title", "figure"] as const;
export type Text = (typeof text)[number];

export const spacing = ["0", "3xs", "2xs", "xs", "sm", "md", "lg", "xl", "2xl", "3xl", "4xl"] as const;
export type Spacing = (typeof spacing)[number];

export const width = ["sheet"] as const;
export type Width = (typeof width)[number];

export const font = ["sans"] as const;
export type Font = (typeof font)[number];

export const duration = ["fast", "base", "slow", "fast-exit", "base-exit", "slow-exit", "loop"] as const;
export type Duration = (typeof duration)[number];

export const delay = ["stagger"] as const;
export type Delay = (typeof delay)[number];

export const ease = ["standard", "exit", "settle", "linear"] as const;
export type Ease = (typeof ease)[number];

export const animate = ["progress-fill", "progress-sweep"] as const;
export type Animate = (typeof animate)[number];

export const zIndex = ["raised", "overlay", "toast"] as const;
export type ZIndex = (typeof zIndex)[number];
"
`;

