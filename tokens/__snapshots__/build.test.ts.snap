/* The closed theme: Tailwind's defaults are gone, and only these classes compile
   (ADR 0002). Each maps to a mode-aware --ds-* variable. */
@theme inline {
  --*: initial;
  --background-color-page: var(--ds-color-bg-page);
  --background-color-surface: var(--ds-color-bg-surface);
  --background-color-surface-raised: var(--ds-color-bg-surface-raised);
  --background-color-surface-hover: var(--ds-color-bg-surface-hover);
