  "effectStyles": [
    {
      "name": "shadow/raised",
      "effects": [
        {
          "type": "DROP_SHADOW",
          "bind": {
            "color": "shadow/raised/1/color",
            "offsetX": "shadow/raised/1/offset-x",
            "offsetY": "shadow/raised/1/offset-y",
            "radius": "shadow/raised/1/blur",
            "spread": "shadow/raised/1/spread"
          }
        },
        {
          "type": "DROP_SHADOW",
