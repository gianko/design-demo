{
  "motion": {
    "duration": {
      "$type": "duration",
      "$description": "Exits run at 70% of the enter duration.",
      "fast": {
        "$description": "Press, hover colour.",
        "$value": { "value": 120, "unit": "ms" }
      },
      "base": {
        "$description": "State change, selection.",
        "$value": { "value": 240, "unit": "ms" }
      },
      "slow": {
        "$description": "Sheet, modal, toast entering.",
        "$value": { "value": 320, "unit": "ms" }
      },
      "fast-exit": { "$value": { "value": 84, "unit": "ms" } },
      "base-exit": { "$value": { "value": 168, "unit": "ms" } },
      "slow-exit": { "$value": { "value": 224, "unit": "ms" } },
      "loop": {
        "$description": "One pass of the progress sweep, the one loop.",
        "$value": { "value": 1280, "unit": "ms" }
      }
    },
    "timeout": {
      "$type": "duration",
      "$description": "How long something stays before it leaves on its own: a timer's length, not an animation's, so no class. tokens.ts carries the values for code (ADR 0005).",
      "toast": {
        "$description": "How long a success toast stays before it leaves on its own; its timer pauses while hovered, focused within or the tab is hidden.",
        "$value": { "value": 5000, "unit": "ms" }
      }
    },
    "delay": {
      "$type": "duration",
      "stagger": {
        "$description": "Between rows whose status changed.",
        "$value": { "value": 40, "unit": "ms" }
      }
    },
    "ease": {
      "$type": "cubicBezier",
      "standard": {
        "$description": "Ease-out, the default.",
        "$value": [0.2, 0, 0, 1]
      },
      "exit": {
        "$description": "Ease-in, for leaving.",
        "$value": [0.4, 0, 1, 1]
      },
      "settle": {
        "$description": "One overshoot of about 4%, only to confirm what the user did. Never on exits.",
        "$value": [0.3, 1.3, 0.6, 1.02]
      },
      "linear": {
        "$description": "Only the progress sweep.",
        "$value": [0, 0, 1, 1]
      }
    },
    "animate": {
      "$type": "transition",
      "$description": "Each names a keyframe in keyframes.css.",
      "progress-fill": {
        "$description": "A pending action fills its progress edge once.",
        "$value": {
          "duration": "{motion.duration.slow}",
          "delay": { "value": 0, "unit": "ms" },
          "timingFunction": "{motion.ease.standard}"
        },
        "$extensions": {
          "design-demo": { "animation": { "fillMode": "both" } }
        }
      },
      "progress-sweep": {
        "$description": "If still pending once full, the edge sweeps until the result arrives.",
        "$value": {
          "duration": "{motion.duration.loop}",
          "delay": "{motion.duration.slow}",
          "timingFunction": "{motion.ease.linear}"
        },
        "$extensions": {
          "design-demo": {
            "animation": { "iterations": "infinite", "fillMode": "backwards" }
          }
        }
      }
    }
  }
}
