.DS_Store
.claude/worktrees/
# A session's scratch files (AGENTS.md § Working copy).
# The folder is kept, so it is there in every new worktree.
.scratch/*
!.scratch/.gitkeep
node_modules/
storybook-static/
# rtk's vitest wrapper writes its JSON report here.
.vitest/
.env
# Generator output (ADR 0010): stand-alone runs and eval-run scratch.
.generated/
evals/runs/
# Written by `pnpm evals:report` (ADR 0008).
evals/reports/
# Written by the Playwright pass of `pnpm gate`.
gates/out/
# figma:sync-tokens scripts, written fresh from tokens/figma.json each run.
figma/out/
